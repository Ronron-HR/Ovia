{
  // Cloudflare Workers Static Assets: uploader den byggede side (dist/).
  // Bygget køres af Cloudflares build-kommando (npm run build) FØR deploy.
  // Filen findes, så `wrangler deploy` ikke autokonfigurerer projektet og
  // kører bygget igen med et andet Vite-setup (det brød forudrenderingen).
  //
  // Siden er udelukkende statiske filer: ingen worker-kode, ingen backend.
  // Viderestillinger står i public/_redirects, headers i public/_headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovia",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
