{
  // Cloudflare Workers Static Assets: uploader den byggede side (dist/).
  // Bygget køres af Cloudflares build-kommando (npm run build) FØR deploy.
  // Filen findes, så `wrangler deploy` ikke autokonfigurerer projektet og
  // kører bygget igen med et andet Vite-setup (det brød forudrenderingen).
  //
  // Siden er statiske filer. Kun /api/* (henvendelser fra prisberegneren) rammer
  // workeren i worker/index.js (run_worker_first); alt andet serveres som
  // statiske filer uden at køre kode.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovia",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Afsender og modtager af mailen med henvendelsen.
  "vars": {
    "MAIL_FROM": "kontakt@oviaspecs.com",
    "MAIL_TO": "ronnyhong723@gmail.com"
  },

  // Rate limit pr. IP med Workers Rate Limiting-bindingen (ikke hukommelse):
  // højst 5 henvendelser pr. minut. namespace_id er et frit valgt tal.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "4711", "simple": { "limit": 5, "period": 60 } }],

  // Mail med Cloudflare Email Routing. Modtageren er bekræftet (Verified).
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "ronnyhong723@gmail.com" }],

  // Daglig cron kl. 05:00 UTC (07:00 dansk sommertid, 06:00 vintertid):
  // sender fejlede mails igen, opgiver efter 3 genforsøg og mailer en opsummering
  // (worker/index.js, runDaily). Kører kun på den udgivne version, ikke på preview.
  "triggers": { "crons": ["0 5 * * *"] }

  // ---- MANGLER: D1-databasens ID ------------------------------------------
  // Indtil bindingen DB findes, svarer /api/henvendelse 503, og formularen viser
  // "Det gik ikke igennem. Ring på … i stedet." Intet påstås sendt.
  // Tabellen oprettes med worker/schema.sql i D1-konsollen.
  //
  // , "d1_databases": [{ "binding": "DB", "database_name": "ovia-henvendelser", "database_id": "<DATABASE ID>" }]
}
