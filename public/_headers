# Cloudflare Pages / Workers Assets: cache-regler.
# Filer i /assets har hash i navnet og kan gemmes i et år. Skrifter og portræt
# har faste navne og gemmes en uge.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

/ronny.*
  Cache-Control: public, max-age=604800
