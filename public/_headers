# Cloudflare Workers Static Assets: sikkerhedsheaders og cache-regler.
#
# CSP: siden henter kun fra sig selv. Det ene indlejrede script (vagthunden i
# index.html) tillades med sin hash; scripts/prerender.mjs udfylder
# pladsholderen i script-src ved build. 'unsafe-inline' i style-src skyldes det indlejrede
# stylesheet og React's style-attributter; der indsættes aldrig brugerindhold som
# HTML. Formularerne sender kun til siden selv (connect-src og form-action).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Filer i /assets har hash i navnet og kan gemmes i et år. Skrifter og portræt
# har faste navne og gemmes en uge.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

/ronny.*
  Cache-Control: public, max-age=604800

/demoer/*.webp
  Cache-Control: public, max-age=604800
